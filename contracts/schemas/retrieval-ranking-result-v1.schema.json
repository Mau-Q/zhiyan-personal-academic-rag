{
  "$defs": {
    "RankedCandidateV1": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Document Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "rank",
        "chunk_id",
        "document_id"
      ],
      "title": "RankedCandidateV1",
      "type": "object"
    }
  },
  "$id": "https://github.com/Mau-Q/zhiyan-personal-academic-rag/contracts/retrieval-ranking-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Backend",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/RankedCandidateV1"
      },
      "title": "Candidates",
      "type": "array"
    },
    "dataset_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Dataset Version",
      "type": "string"
    },
    "decision": {
      "enum": [
        "EVIDENCE_FOUND",
        "NO_EVIDENCE",
        "FORBIDDEN"
      ],
      "title": "Decision",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "question_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Question Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "retrieval_ranking_result_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "top_k": {
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "dataset_version",
    "question_id",
    "backend",
    "top_k",
    "decision",
    "latency_ms",
    "candidates"
  ],
  "title": "RetrievalRankingResultV1",
  "type": "object"
}
