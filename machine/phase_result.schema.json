{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zhiyan-personal-academic-rag/phase-result-v1.schema.json",
  "title": "Repository Harness Phase Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "template_only",
    "result",
    "execution_boundary",
    "base_commit",
    "result_commit",
    "workspace_clean",
    "checks",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "phase_result_v1"},
    "phase_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "template_only": {"type": "boolean"},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "execution_boundary": {"type": "string", "minLength": 1},
    "base_commit": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        {"type": "null"}
      ]
    },
    "result_commit": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        {"type": "null"}
      ]
    },
    "workspace_clean": {"type": ["boolean", "null"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
